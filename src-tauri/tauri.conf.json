{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lucid-spell",
  "version": "1.2.0",
  "identifier": "io.github.l1ngus.lucid-spell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lucid Spell",
        "decorations": false,
        "width": 550,
        "height": 250,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 l1ngus",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE"
  }
}
